{
  // Pair with Settings → Agents → Auto-review + Allowlist with Sandbox ON.
  // External-File + File-Deletion protections stay ON (workspace boundary).
  "mcpAllowlist": [
    "github:*",
    "cursor:*",
    "cursor-app-control:*",
    "cursor-ide-browser:*"
  ],
  "terminalAllowlist": [
    "./build",
    "cargo",
    "cat",
    "cd",
    "cp",
    "curl",
    "defaults",
    "docker",
    "echo",
    "export",
    "find",
    "gh",
    "git",
    "grep",
    "head",
    "kill",
    "lsof",
    "ls",
    "make",
    "mkdir",
    "npm",
    "pgrep",
    "pkill",
    "pnpm",
    "printf",
    "python3",
    "readelf",
    "rg",
    "rm",
    "sleep",
    "tail",
    "tee",
    "test",
    "wc",
    "uname",
    "while",
    "yarn"
  ],
  "autoRun": {
    "allow_instructions": [
      "Routine progressive-lsp work in this repo and paths listed in .cursor/sandbox.json additionalReadwritePaths: git, cargo, docker, ./build, xtask pack/runtime-image/check-static, llvm-cov, mutants.",
      "Read-only inspection: rg, readelf, python3 ELF checks, tail/tee logs under /tmp, wait loops with while/sleep on pack jobs.",
      "Git lock cleanup in this repo when sync failed: kill stale git, rm .git/*.lock, git reset --hard origin/main only when user asked to sync main.",
      "Use default sandbox + network from sandbox.json; request git_write for commits when user asked; avoid required_permissions all unless sandbox cannot run the command.",
      "Do not ask in chat for permission to run these; run them."
    ],
    "block_instructions": [
      "git config changes, --no-verify, stash, force-push to main/master, destructive git outside user request.",
      "File edits or writes outside the opened workspace root except shell effects in sandbox additionalReadwritePaths.",
      "Production deploys, cloud credentials, kubectl apply, or broad host access when sandbox + network would suffice.",
      "Deleting user data outside the repo; rm -rf on home or unrelated projects."
    ]
  }
}
